{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@core/*": ["src/core/*"],
			"@cxxi-lab/hub-sdk": ["src/sdk/index.ts"],
			"@shared/*": ["src/shared/*"],

			"@platform": ["src/platform"],
			"@platform/*": ["src/platform/*"],
			"@platform-impl": ["src/platform/electron.ts"],
			"@preload": ["../platforms/desktop/src/preload"]
		}
	},
	"include": ["src"]
}
