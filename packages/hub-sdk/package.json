{
	"name": "@cxxi-lab/hub-sdk",
	"version": "2.0.1",
	"description": "The contract of hub's modules: the SDK a module builds on (provided by the host app at run time), and the SDK of the modules running isolated in their frame.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./types/index.d.ts"
		},
		"./frame": "./frame/index.ts",
		"./protocol": "./protocol.ts",
		"./version.json": "./version.json",
		"./shared.json": "./shared.json",
		"./package.json": "./package.json"
	},
	"files": [
		"types",
		"frame",
		"protocol.ts",
		"version.json",
		"LICENSE",
		"shared.json"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cxxi-lab/hub-apps.git",
		"directory": "packages/hub-sdk"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@cxxi-lab/hub-ui": "^0.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4"
	}
}
