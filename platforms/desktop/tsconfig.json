{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"types": ["electron-vite/node"],
		"baseUrl": ".",
		"paths": {
			"@preload": ["src/preload"]
		}
	},
	"include": ["src", "electron.vite.config.ts"]
}
