<?xml version="1.0" encoding="utf-8"?>
<!--
  Android's defaults (no cleartext, the system's certificate authorities), plus one exception: the
  local AI engine (AiEngine) listens on 127.0.0.1 in the app's own AI process, in plain HTTP with a
  random key; nothing leaves the device.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
